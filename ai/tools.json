      "accepts": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/heic",
        "image/heif",
        "image/avif",
        "image/gif",
        "image/bmp",
        "image/tiff",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp",
        ".heic",
        ".heif",
        ".avif",
        ".gif",
        ".bmp",
        ".tif",
        ".tiff"
      ],
      "outputs": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ],
      "automation": {
        "input": "#fileInput",
        "action": "#runButton",
        "result": "#resultsPanel",
        "download": "#downloadAllButton",
        "controls": [
          {
            "selector": "#resizeInput",
            "element": "input",
            "type": "checkbox",
            "min": "16",
            "max": "4096",
            "step": "1",
            "value": "1200"
          },
          {
            "selector": "#qualityInput",
            "element": "select",
            "type": "select",
            "value": "compact",
            "values": [
              "compact",
              "standard",
              "high"
            ]
          },
          {
            "selector": "#renameInput",
            "element": "input",
            "type": "checkbox"
          },
          {
            "selector": "#baseNameInput",
            "element": "input",
            "type": "text",
            "value": "web"
          },
          {
            "selector": "#startNumberInput",
            "element": "input",
            "type": "number",
            "min": "1",
            "max": "999999",
            "value": "1"
          }
        ],
        "events": {
          "ready": "shiagent:ready",
          "state": "shiagent:statechange",
          "outputs": "shiagent:outputs",
          "tray": "shiagent:traychange",
          "error": "shiagent:error"
        }
      },
