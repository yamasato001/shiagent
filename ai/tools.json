{
  "schema": "https://shiagent.com/ai/tools.schema.json",
  "version": "1.0",
  "site": {
    "name": "SHIAGENT",
    "origin": "https://shiagent.com",
    "privacy": "Files are processed on the user's device and are not uploaded."
  },
  "browserApi": {
    "global": "window.SHIAGENT",
    "documentation": "https://shiagent.com/llms-full.txt"
  },
  "tools": [
    {
      "id": "background-remover",
      "route": "background-remover",
      "status": "active",
      "category": "image",
      "localProcessing": true,
      "accepts": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif",
        "image/bmp",
        "image/avif",
        "image/heic",
        "image/heif",
        "image/tiff",
        ".png",
        ".jpg",
        ".jpeg",
        ".jfif",
        ".webp",
        ".gif",
        ".bmp",
        ".avif",
        ".heic",
        ".heif",
        ".tif",
        ".tiff"
      ],
      "outputs": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ],
      "automation": {
        "input": "#fileInput",
        "action": "#processButton",
        "result": "#resultsPanel",
        "download": "#downloadAllButton",
        "controls": [],
        "events": {
          "ready": "shiagent:ready",
          "state": "shiagent:statechange",
          "outputs": "shiagent:outputs",
          "tray": "shiagent:traychange",
          "error": "shiagent:error"
        }
      },
      "name": {
        "en": "Background Remover",
        "ja": "背景削除・背景色"
      },
      "description": {
        "en": "Make white or solid-color backgrounds transparent, or replace them with any solid color. Works in your browser with PNG, JPEG, WebP, HEIC and more. No uploads.",
        "ja": "PNG・JPEG・WebP・HEIC画像の白・単色背景を透明化し、白・黒・任意色へ置換。複数画像をアップロードせずブラウザ内で一括処理できます。"
      },
      "paths": {
        "en": "/background-remover/",
        "ja": "/ja/background-remover/"
      }
    },
    {
      "id": "batch-rename",
      "route": "batch-rename",
      "status": "active",
      "category": "batch",
      "localProcessing": true,
      "accepts": [],
      "outputs": [
        "application/zip",
        "original media types"
      ],
      "automation": {
        "input": "#fileInput",
        "action": "#applyButton",
        "result": "#resultsPanel",
        "download": "#downloadButton",
        "controls": [
          {
            "selector": "#suffixInput",
            "element": "input",
            "type": "text",
            "value": "_"
          }
        ],
        "events": {
          "ready": "shiagent:ready",
          "state": "shiagent:statechange",
          "outputs": "shiagent:outputs",
          "tray": "shiagent:traychange",
          "error": "shiagent:error"
        }
      },
      "name": {
        "en": "Batch Rename",
        "ja": "一括リネーム"
      },
      "description": {
        "en": "Bulk rename images, PDFs, documents, audio, video, archives and other files in your browser. Keep extensions and save everything as a ZIP. No uploads.",
        "ja": "画像、PDF、文書、音声、動画などのファイル名を連番で一括変更。接頭辞、開始番号、桁数、区切り文字を指定し、拡張子を維持して保存できます。"
      },
      "paths": {
        "en": "/batch-rename/",
        "ja": "/ja/batch-rename/"
      }
    },
    {
      "id": "canvas-padding",
      "route": "canvas-padding",
      "status": "active",
      "category": "image",
      "localProcessing": true,
      "accepts": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/heic",
        "image/heif",
        "image/avif",
        "image/gif",
        "image/bmp",
        "image/tiff",
        ".png",
        ".jpg",
        ".jpeg",
        ".webp",
        ".heic",
        ".heif",
        ".avif",
        ".gif",
        ".bmp",
        ".tif",
        ".tiff"
      ],
      "outputs": [
        "image/png",
        "image/jpeg",
        "image/webp"
      ],
      "automation": {
        "input": "#fileInput",
        "action": "#paddingButton",
        "result": "#resultsPanel",
        "download": "#downloadAllButton",
        "controls": [
          {
            "selector": "#canvasWidth",
            "element": "input",
            "type": "number",
            "min": "1",
            "max": "32767",
            "value": "512"
          },
          {
            "selector": "#customColor",
            "element": "input",
            "type": "color",
            "value": "#ffffff"
          },
          {
            "selector": "#quality",
            "element": "select",
            "type": "select",
            "value": "compact",
            "values": [
              "compact",
              "standard",
              "high"
            ]
          }
        ],
        "events": {
          "ready": "shiagent:ready",
          "state": "shiagent:statechange",
          "outputs": "shiagent:outputs",
          "tray": "shiagent:traychange",
          "error": "shiagent:error"
        }
      },
      "name": {
        "en": "Canvas Padding Add image margins",
        "ja": "余白追加"
      },
      "description": {
        "en": "Add pixel or percentage padding around images, or center them on a fixed 512×512 canvas. Batch process images with transparent, white, black, or custom backgrounds.",
        "ja": "画像の上下左右へpx・％で余白を追加し、512×512など指定キャンバスの中央へ配置。透明・白・黒・任意色の背景で複数画像を一括処理できます。"
      },
      "paths": {
        "en": "/canvas-padding/",
        "ja": "/ja/canvas-padding/"
      }
    },
